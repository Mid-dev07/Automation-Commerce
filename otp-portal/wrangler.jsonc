{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seiton-otp-portal",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "OTP_KV",
      "id": "06ed220a5b2741b6aaca79977a10ad23"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
