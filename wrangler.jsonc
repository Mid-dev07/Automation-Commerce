{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seiton-order-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "vars": {
    "GOOGLE_SHEETS_ID": "137aLgWekyqy0cbdsPkVIgszm6oMKAKeZ-coK5knMwic"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seiton-transactions-prod",
      "database_id": "35483d1c-58e9-4b44-a6cd-648041c5e244",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "seiton-product-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_COORDINATOR",
        "class_name": "OrderCoordinator"
      }
    ]
  },
  "exports": {
    "default": {
      "type": "worker"
    },
    "OrderCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "2026110901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "previews": {
    "vars": {
      "APP_ENV": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "seiton-preview-transactions-20261109",
        "database_id": "c98e9147-8a53-4fb1-bee2-d33e966baeb7"
      }
    ],
    "r2_buckets": [
      {
        "binding": "PRODUCT_MEDIA",
        "bucket_name": "seiton-preview-product-media-20261109"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "ORDER_COORDINATOR",
          "class_name": "OrderCoordinator"
        }
      ]
    },
    "observability": {
      "enabled": true,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "head_sampling_rate": 1
      },
      "traces": {
        "enabled": false
      }
    }
  }
}
