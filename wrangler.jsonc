{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seiton-order-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seiton-transactions-prod",
      "database_id": "35483d1c-58e9-4b44-a6cd-648041c5e244"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_COORDINATOR",
        "class_name": "OrderCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderCoordinator"]
    }
  ]
}
