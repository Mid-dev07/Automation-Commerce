{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seiton-order-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "vars": {
    "GOOGLE_SHEETS_ID": "137aLgWekyqy0cbdsPkVIgszm6oMKAKeZ-coK5knMwic",
    "OTP_PORTAL_URL": "https://otp.seiton.biz.id",
    "OTP_EMAIL_ROUTING_READY": "false",
    "QRIS_INTERNAL_ENABLED": "true",
    "QRIS_STATIC_FALLBACK_ENABLED": "true",
    "ENABLE_BUTTON_STYLES": "true",
    "SUPPORT_URL": "https://seiton.biz.id/kontak/"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seiton-transactions-prod",
      "database_id": "35483d1c-58e9-4b44-a6cd-648041c5e244"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MUSE_KV",
      "id": "25fd738d46634cbca8e4d0af701d05b7"
    },
    {
      "binding": "OTP_KV",
      "id": "06ed220a5b2741b6aaca79977a10ad23"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_COORDINATOR",
        "class_name": "OrderCoordinator"
      }
    ]
  },
  "exports": {
    "default": {
      "type": "worker"
    },
    "OrderCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "2026110901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "seiton-product-media"
    }
  ]
}
